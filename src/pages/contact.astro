---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reader } from '../lib/content';

const journal = (await reader.singletons.journal.read())!;
---

<BaseLayout
  title="Contact — Virtue Literacy Africa"
  description="Get in touch with Virtue Literacy Africa. Send a message about partnership, sponsorship, media, or volunteering."
  currentPage="/contact"
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Contact</span>
      <h1>Let's talk.</h1>
      <p>Whether you have a partnership proposal, a media enquiry, or just a question — we want to hear from you. Reach out via the form below or directly by email.</p>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="contact-section">
    <div class="container contact-grid">

      <div class="contact-form">
        <h2>Send a message.</h2>
        <form
          id="contact-form"
          onsubmit="
            event.preventDefault();
            document.getElementById('contact-form').style.display='none';
            document.getElementById('form-success').style.display='block';
          "
        >
          <div class="form-row">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div class="form-row">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.org" />
          </div>
          <div class="form-row">
            <label for="organisation">Organisation (optional)</label>
            <input type="text" id="organisation" name="organisation" placeholder="Your organisation" />
          </div>
          <div class="form-row">
            <label for="subject">I am getting in touch about</label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>Select a topic</option>
              <option value="financial-sponsorship">Financial Sponsorship</option>
              <option value="in-kind-donation">In-Kind Donation</option>
              <option value="professional-volunteering">Professional Volunteering</option>
              <option value="media-communications">Media &amp; Communications</option>
              <option value="institutional-partnership">Institutional Partnership</option>
              <option value="governance-partnership">Governance &amp; Democracy Sector Partnership</option>
              <option value="ajgad-submission">{journal.acronym} &mdash; Journal Submission</option>
              <option value="ajgad-partnership">{journal.acronym} &mdash; Journal Partnership</option>
              <option value="other">Something else</option>
            </select>
          </div>
          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" required placeholder="Tell us what you have in mind..."></textarea>
          </div>
          <button type="submit" class="btn btn-accent">Send message &rarr;</button>
        </form>
        <div id="form-success" class="form-success" role="alert">
          <strong>Message received.</strong> Thank you for reaching out. We will get back to you within 3 working days.
        </div>
      </div>

      <aside>
        <div class="library-card">
          <span class="lc-label">Contact details</span>
          <h3>Virtue Literacy Africa</h3>
          <div class="lc-row">
            <strong>Lead</strong>
            <span>Kirangacha Mwaniki</span>
          </div>
          <div class="lc-row">
            <strong>Email</strong>
            <span><a href="mailto:info@virtueliteracyafrica.org">info@virtueliteracyafrica.org</a></span>
          </div>
          <div class="lc-row">
            <strong>Location</strong>
            <span>Nairobi, Kenya</span>
          </div>
          <div class="lc-row">
            <strong>Journal</strong>
            <span><a href="/ajgad">{journal.acronym}</a></span>
          </div>
        </div>

        <div class="callout" style="margin-top:1.5rem">
          <span class="callout-label">Response time</span>
          <h3>We aim to respond within 3 working days.</h3>
          <p>For urgent media or partnership enquiries, please include that in your subject selection and we will prioritise accordingly.</p>
        </div>
      </aside>

    </div>
  </section>

  <!-- FOOT CTA -->
  <section class="act" style="border-top:2px solid var(--ink)">
    <div class="container">
      <h2>Explore further.</h2>
      <div class="act-grid reveal">
        <div class="act-cell">
          <h3>Get involved</h3>
          <p>See the six specific ways you can partner with, fund, or volunteer for VLA.</p>
          <a class="go" href="/get-involved">Partnership options &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Our programmes</h3>
          <p>Understand the six pillars and how each one creates impact &mdash; from the community to the policy table.</p>
          <a class="go" href="/programmes">Six pillars &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Our story</h3>
          <p>From <em>Place Called Kibera</em> to a five-pillar programme — the full background.</p>
          <a class="go" href="/about">Our story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      "use strict";
      var params = new URLSearchParams(window.location.search);

      var subject = params.get("subject");
      if (subject) {
        var sel = document.getElementById("subject");
        if (sel && [].some.call(sel.options, function (o) { return o.value === subject; })) {
          sel.value = subject;
        }
      }

      var amount = params.get("amount");
      if (amount) {
        var frequency = params.get("frequency");
        var funds = params.get("funds");
        var freqWord = frequency === "monthly" ? "a monthly gift" : "a one-time gift";
        var msg = "I'd like to make " + freqWord + " of " + amount;
        if (funds) { msg += ", to fund " + funds.charAt(0).toLowerCase() + funds.slice(1); }
        msg += ". Please let me know how to proceed with payment (M-Pesa or bank transfer).";
        var ta = document.getElementById("message");
        if (ta) { ta.value = msg; }
      }
    })();
  </script>

</BaseLayout>
