---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Get Involved — Virtue Literacy Africa"
  description="Partner with, fund, or volunteer for Virtue Literacy Africa. Six ways to support literacy, civic education, and AI learning in Nairobi's informal settlements."
  currentPage="/get-involved"
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Partnership &amp; Support</span>
      <h1>There is a role for everyone in this work.</h1>
      <p>Virtue Literacy Africa invites partners, funders, corporates, governments, and individuals to join us in building literacy, civic awareness, and opportunity in Africa's informal settlements.</p>
    </div>
  </section>

  <!-- SIX WAYS TO GET INVOLVED -->
  <section class="gi-section">
    <div class="container">
      <span class="kicker">How to get involved</span>
      <h2>Six ways to support VLA.</h2>
      <ul class="gi-list reveal">
        <li>
          <span class="gi-num">1</span>
          <div class="gi-body">
            <h3>Financial Sponsorship</h3>
            <p>Fund a mobile library unit, a book publication, a fellowship cohort, or a civic education event. All gifts are tied to named, reportable deliverables.</p>
          </div>
        </li>
        <li>
          <span class="gi-num">2</span>
          <div class="gi-body">
            <h3>In-Kind Donations</h3>
            <p>Books, technology hardware, vehicles, printing services, or office space. In-kind support is credited and reported in our annual impact report.</p>
          </div>
        </li>
        <li>
          <span class="gi-num">3</span>
          <div class="gi-body">
            <h3>Professional Volunteering</h3>
            <p>Mentors, illustrators, civic educators, AI practitioners, health workers, and storytellers. Skills-based volunteering is integral to how we deliver every pillar.</p>
          </div>
        </li>
        <li>
          <span class="gi-num">4</span>
          <div class="gi-body">
            <h3>Media &amp; Communications</h3>
            <p>Help document and amplify VLA's work through journalism, photography, film, or social media. Visibility is essential to our fundraising and advocacy mission.</p>
          </div>
        </li>
        <li>
          <span class="gi-num">5</span>
          <div class="gi-body">
            <h3>Institutional Partnerships</h3>
            <p>Schools, universities, health NGOs, county and national government agencies. Institutional partnerships extend our reach and ground our programmes in existing community infrastructure.</p>
          </div>
        </li>
        <li>
          <span class="gi-num">6</span>
          <div class="gi-body">
            <h3>Governance &amp; Democracy Sector Partnerships</h3>
            <p>Legal aid organisations, know-your-rights NGOs, civic tech initiatives, and election-monitoring bodies. Civic education is at the heart of VLA's work, and these partnerships deepen it.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- GET IN TOUCH CALLOUT -->
  <section style="padding:clamp(4rem,8vw,7rem) 0;border-bottom:2px solid var(--ink)">
    <div class="container reveal">
      <div class="callout">
        <span class="callout-label">Get In Touch</span>
        <h3>Kirangacha Mwaniki &mdash; Virtue Literacy Africa</h3>
        <p>To discuss a partnership, sponsorship, or volunteering opportunity, reach us directly. We welcome conversations at any stage — whether you have a fully-formed proposal or just an opening question.</p>
        <p style="margin-top:0.75rem">
          <a href="mailto:virtue.book@africa.org" style="color:var(--ink);font-weight:700;text-decoration:underline;text-decoration-color:var(--accent)">virtue.book@africa.org</a>
          &nbsp;&middot;&nbsp; Nairobi, Kenya
        </p>
        <a href="/contact" class="btn btn-accent" style="margin-top:1.2rem;display:inline-flex">Send a message &rarr;</a>
      </div>
    </div>
  </section>

  <!-- NUMBERS BAND -->
  <section class="nums">
    <div class="container">
      <span class="kicker">Phase 1 targets &middot; Year 1</span>
      <div class="nums-grid">
        <div class="cell"><span class="n">3</span><span class="l">settlements in Nairobi</span></div>
        <div class="cell"><span class="n">5</span><span class="l">programme pillars</span></div>
        <div class="cell"><span class="n">2</span><span class="l">mobile library units</span></div>
        <div class="cell"><span class="n">2</span><span class="l">new books published</span></div>
      </div>
    </div>
  </section>

  <!-- SECONDARY CTA -->
  <section class="act">
    <div class="container">
      <h2>Ready to start?</h2>
      <div class="act-grid reveal">
        <div class="act-cell">
          <h3>Contact us</h3>
          <p>Send a message via our contact form and a member of the team will respond within 3 working days.</p>
          <a class="go" href="/contact">Contact form &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Learn more</h3>
          <p>Read the full detail of our five programme pillars and how each creates impact.</p>
          <a class="go" href="/programmes">Our programmes &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Our story</h3>
          <p>Understand the background, the problem we're solving, and the communities we serve.</p>
          <a class="go" href="/about">Our story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
