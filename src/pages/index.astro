---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import girlWithSlate from '../assets/girl-with-slate.jpg';
import pastoralistChildren from '../assets/pastoralist-children.jpg';
import girlsReading from '../assets/girls-reading.jpg';
import classroomHandsRaised from '../assets/classroom-hands-raised.jpg';
import drylandsCommunity from '../assets/drylands-community.jpg';
import communityGathering from '../assets/community-gathering.jpg';
import childrenWriting from '../assets/children-writing.jpg';
import childrenHappy from '../assets/children-happy.jpg';
import WhereWeWork from '../components/WhereWeWork.astro';
---

<BaseLayout
  title="Virtue Literacy Africa: Reading is the first right"
  description="Virtue Literacy Africa advances literacy for children and youth in pastoralist, refugee, and arid and semi-arid communities across Kenya, Ethiopia, and South Sudan."
  currentPage="/"
>

  <!-- 1 · HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker">Virtue Literacy Africa &middot; Kenya, Ethiopia, South Sudan</span>
        <h1>Meeting children where <span class="ac">they are.</span></h1>
        <div class="lower">
          <div class="hero-lede">
            <p>Advancing literacy for children and youth in marginalised and displaced communities across Africa.</p>
            <p>Across Kenya, Ethiopia, and South Sudan, children in pastoralist communities, refugee populations, and arid and semi-arid areas face some of the widest gaps in access to schooling and literacy. Not for lack of talent or ambition, but because seasonal migration, displacement, and education systems built for fixed populations have left them behind.</p>
          </div>
          <div class="actions">
            <a href="/get-involved" class="btn btn-accent">Partner with us</a>
            <a href="/programmes" class="btn">Explore programmes</a>
          </div>
        </div>
      </div>
      <figure class="hero-fig">
        <Image
          src={girlWithSlate}
          alt="A girl holding a writing slate outside her home"
          width={900}
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>A reader and her writing slate</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2 · DOCUMENTARY PHOTO -->
  <figure class="testimony reveal">
    <Image
      src={pastoralistChildren}
      alt="Children sitting together on a bench in a pastoralist village in the East African drylands"
      width={1600}
      format="webp"
      quality={72}
    />
    <figcaption>Where families move with the seasons, a school in a fixed location reaches a child for only part of the year.</figcaption>
  </figure>

  <!-- 3 · BACKGROUND -->
  <section class="background-section">
    <div class="container">
      <div class="reveal">
        <span class="kicker">Who we are</span>
        <h2>Built for populations that stay in one place.</h2>
        <p>Virtue Literacy Africa works at the intersection of literacy and innovation, including artificial intelligence, to open new pathways for learning, opportunity, and voice for young people whose communities have often been overlooked by conventional systems.</p>
        <p>Our work reaches pastoralist communities, refugee populations, and children in arid and semi-arid areas. These are communities that carry deep resilience and hard-won knowledge of adapting to change, yet whose children frequently face the widest gaps in access to schooling and literacy support. The causes are structural: seasonal migration, displacement, dry and unpredictable environments, and education systems that were never designed with mobile or crisis-affected populations in mind.</p>
        <p>We close that gap by meeting children where they are, rather than expecting them to fit into systems that were never built for their circumstances.</p>

        <div class="callout">
          <span class="callout-label">What we believe</span>
          <h3>Literacy is more than a skill.</h3>
          <p>It is a foundation for dignity, opportunity, and voice. Through community literacy programmes, mobile learning, and community reading spaces, we partner with religious institutions, families, local leaders, and communities to build pathways to literacy that respect and reflect the realities they navigate.</p>
        </div>

        <p style="margin-top:1rem"><a href="/about" class="btn" style="margin-top:0.5rem">Our full story &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- 4 · FIVE PILLARS OVERVIEW -->
  <section class="index" id="programmes">
    <div class="container">
      <div class="top reveal">
        <h2>Five pillars, one ecosystem.</h2>
        <p>From literacy programmes that travel with the community to evidence that reaches the people making decisions about it.</p>
      </div>
      <div class="pillar-index reveal">
        <article class="pcell feature">
          <div class="ph">
            <Image src={girlsReading} alt="Three schoolgirls reading a book together at a desk" width={700} format="webp" quality={72} />
            <span class="pn">01</span>
          </div>
          <div class="pbody">
            <h3>Literacy Programmes</h3>
            <p>Community-based literacy for children and youth, run in the environments they actually live in, including mobile and seasonal communities.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={classroomHandsRaised} alt="Pupils raising their hands in a crowded classroom" width={700} format="webp" quality={72} />
            <span class="pn">02</span>
          </div>
          <div class="pbody">
            <h3>Mobile &amp; Community Learning</h3>
            <p>Learning spaces that adapt to migration, displacement, and the realities of arid and semi-arid areas.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={drylandsCommunity} alt="A pastoralist community walking a dirt road past a mobile network mast" width={700} format="webp" quality={72} />
            <span class="pn">03</span>
          </div>
          <div class="pbody">
            <h3>Innovation &amp; AI in Education</h3>
            <p>Tools that widen access to learning, including early developmental screening through Mwangaza AI.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={communityGathering} alt="Community members seated together at an outdoor gathering" width={700} format="webp" quality={72} />
            <span class="pn">04</span>
          </div>
          <div class="pbody">
            <h3>Community Partnerships</h3>
            <p>Families, local leaders, and trusted institutions building literacy pathways that hold.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={childrenWriting} alt="Children writing in exercise books at their desks" width={700} format="webp" quality={72} />
            <span class="pn">05</span>
          </div>
          <div class="pbody">
            <h3>Research &amp; Evidence</h3>
            <p>Findings from our own programmes, shared with educators, policymakers, and development partners.</p>
          </div>
        </article>
      </div>

      <p style="margin-top:1.5rem"><a href="/programmes" class="btn">See all programmes &rarr;</a></p>
    </div>
  </section>

  <!-- 5 · VISION & MISSION -->
  <section class="vm-section reveal">
    <div class="container">
      <span class="kicker">Our foundation</span>
      <div class="vm-grid">
        <div class="vm-cell">
          <span class="vm-label">Vision</span>
          <h3>A future where every child, regardless of geography, mobility, or circumstance, has the literacy skills and tools to shape their own opportunity and voice.</h3>
        </div>
        <div class="vm-cell">
          <span class="vm-label">Mission</span>
          <p>To advance literacy for children and youth in marginalised and displaced communities across Africa, including pastoralist populations, refugee communities, and children in arid and semi-arid areas, by combining community-rooted programmes, research and evidence-sharing, and innovation, including artificial intelligence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · WHERE WE WORK -->
  <WhereWeWork
    kicker="Where we work"
    heading="Kenya, Ethiopia, and South Sudan."
  />

  <!-- 7 · ACT -->
  <section class="act" id="act">
    <div class="container">
      <h2>Take part.</h2>
      <div class="act-grid reveal">
        <div class="act-cell">
          <h3>Give</h3>
          <p>Fund a community reading space, a literacy programme cycle, or a round of developmental screening. Every gift maps to a named deliverable.</p>
          <a class="go" href="/donate">Donate &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Partner</h3>
          <p>Schools, faith institutions, NGOs, county and national agencies, and development partners.</p>
          <a class="go" href="/get-involved">Start a conversation &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Volunteer</h3>
          <p>Teachers, facilitators, translators, screening specialists, illustrators, and researchers.</p>
          <a class="go" href="/get-involved">Give your skills &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · OUR STORY CLOSE -->
  <section class="close" id="story">
    <div class="container close-grid">
      <div class="reveal">
        <span class="kicker">Our story</span>
        <h2>Every child, wherever they are.</h2>
        <p>We are committed to walking alongside marginalised and displaced communities in Kenya, Ethiopia, and South Sudan, using both tradition and innovation, to make literacy accessible to every child.</p>
        <div class="actions">
          <a href="/about" class="btn btn-accent">Our full story</a>
          <a href="/research" class="btn">Research &amp; findings</a>
        </div>
      </div>
      <figure class="close-fig reveal">
        <Image
          src={childrenHappy}
          alt="Children laughing together in a sunlit village street"
          width={900}
          format="webp"
          quality={72}
        />
      </figure>
    </div>
  </section>

</BaseLayout>
