---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import childReading from '../assets/child-reading-book.jpg';
import kiberaAerial from '../assets/kibera-aerial.jpg';
import books from '../assets/books.jpg';
import mobileLibrary from '../assets/mobile-library.jpg';
import civicEducation from '../assets/civic-education.jpg';
import fellowship from '../assets/fellowship.jpg';
import kenyanTeacher from '../assets/kenyan-teacher.jpg';
import childrenHappy from '../assets/children-happy.jpg';
---

<BaseLayout
  title="Virtue Literacy Africa: Reading is the first right"
  description="Virtue Literacy Africa, an initiative of Virtue Books, puts mobile libraries, books, and a civic voice into Nairobi's informal settlements."
  currentPage="/"
>

  <!-- 1 · HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker">Virtue Literacy Africa &middot; Nairobi</span>
        <h1>Empowering children in Africa's informal <span class="ac">settlements.</span></h1>
        <div class="lower">
          <p>Putting mobile libraries, books, civic education, and AI fellowships into Nairobi's informal settlements.</p>
          <div class="actions">
            <a href="/get-involved" class="btn btn-accent">Partner with us</a>
            <a href="/programmes" class="btn">Explore programmes</a>
          </div>
        </div>
      </div>
      <figure class="hero-fig">
        <Image
          src={childReading}
          alt="A child reading a book"
          width={900}
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>A reader in Nairobi</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2 · DOCUMENTARY PHOTO -->
  <figure class="testimony">
    <Image
      src={kiberaAerial}
      alt="Kibera settlement, Nairobi"
      width={1600}
      format="webp"
      quality={72}
    />
    <figcaption>Kibera, Nairobi. Phase 1 begins in the settlements where Virtue Books first documented life on the ground.</figcaption>
  </figure>

  <!-- 3 · BACKGROUND -->
  <section class="background-section">
    <div class="container">
      <div class="reveal">
        <span class="kicker">Background &amp; Inspiration</span>
        <h2>Born from a book. Grown into a movement.</h2>
        <p>Virtue Literacy Africa emerged from Virtue Books and its 2024 title <em>Place Called Kibera</em> &mdash; a first-person account of life in Nairobi's largest informal settlement. That publication revealed both the depth of the literacy gap and the urgency of a civic response.</p>
        <p>What began as a publishing mission has since expanded into a social mandate: to put mobile libraries, civic education, and AI learning tools into the hands of children and young people who need them most.</p>

        <div class="callout">
          <span class="callout-label">About Place Called Kibera</span>
          <h3>Where the story began</h3>
          <p><em>Place Called Kibera</em> (Virtue Books, 2024) documented life in Nairobi's Kibera settlement through first-person accounts, photography, and narrative. It became the foundation for VLA's commitment to documentation as the first act of civic literacy &mdash; seeing a community clearly, before trying to serve it.</p>
        </div>

        <p style="margin-top:1rem"><a href="/about" class="btn" style="margin-top:0.5rem">Our full story &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- 4 · FIVE PILLARS OVERVIEW -->
  <section class="index" id="programmes">
    <div class="container">
      <div class="top reveal">
        <h2>The five pillars.</h2>
        <p>From documenting communities to backing the young people who will lead them.</p>
      </div>
      <div class="pillar-index reveal">
        <article class="pcell feature">
          <div class="ph">
            <Image src={books} alt="Shelves of children's books" width={700} format="webp" quality={72} />
            <span class="pn">01</span>
          </div>
          <div class="pbody">
            <h3>Documentation, Publishing &amp; Inclusive Books</h3>
            <p>Values-based, civic, and accessible titles &mdash; documented and made with local illustrators. The thread that runs through every other pillar.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={mobileLibrary} alt="A child reading an open book" width={700} format="webp" quality={72} />
            <span class="pn">02</span>
          </div>
          <div class="pbody">
            <h3>Mobile Children's Libraries</h3>
            <p>Roving units bringing reading into communities on a reliable, fixed schedule.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={civicEducation} alt="Young people together outdoors" width={700} format="webp" quality={72} />
            <span class="pn">03</span>
          </div>
          <div class="pbody">
            <h3>Reading, Storytelling &amp; Civic Education Events</h3>
            <p>Children read, compete, learn their rights, and are publicly celebrated.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={fellowship} alt="A child concentrating on a book" width={700} format="webp" quality={72} />
            <span class="pn">04</span>
          </div>
          <div class="pbody">
            <h3>AI Learning Fellowships &amp; Civic Leadership</h3>
            <p>Young people build AI-powered community projects, funded to scale.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={kenyanTeacher} alt="Children learning together" width={700} format="webp" quality={72} />
            <span class="pn">05</span>
          </div>
          <div class="pbody">
            <h3>Inclusive Development &amp; Mwangaza AI</h3>
            <p>Inclusive books and an offline AI tool for caregivers and teachers in low-connectivity settlements.</p>
          </div>
        </article>
      </div>
      <p style="margin-top:1.5rem"><a href="/programmes" class="btn">See all programmes &rarr;</a></p>
    </div>
  </section>

  <!-- 5 · VISION & MISSION -->
  <section class="vm-section reveal">
    <div class="container">
      <span class="kicker">Our foundation</span>
      <div class="vm-grid">
        <div class="vm-cell">
          <span class="vm-label">Vision</span>
          <h3>An Africa where every child, regardless of where they were born, has access to books, knowledge, and the tools to shape their future.</h3>
        </div>
        <div class="vm-cell">
          <span class="vm-label">Mission</span>
          <p>To document Africa's informal settlement realities and respond with mobile libraries, literacy events, civic education, values-based books, and AI learning fellowships &mdash; nurturing children who are not only literate, but informed, empowered, and ready to lead.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · NUMBERS -->
  <section class="nums">
    <div class="container">
      <span class="kicker">Phase 1 &middot; Year 1 in Nairobi</span>
      <div class="nums-grid">
        <div class="cell"><span class="n">3</span><span class="l">settlements: Kibera, Mathare, Korogocho</span></div>
        <div class="cell"><span class="n">5</span><span class="l">programme pillars, working as one</span></div>
        <div class="cell"><span class="n">2</span><span class="l">mobile library units on the road</span></div>
        <div class="cell"><span class="n">2</span><span class="l">new books published in Year 1</span></div>
      </div>
    </div>
  </section>

  <!-- 7 · ACT -->
  <section class="act" id="act">
    <div class="container">
      <h2>Take part.</h2>
      <div class="act-grid reveal">
        <div class="act-cell">
          <h3>Give</h3>
          <p>Fund a mobile unit, a fellowship cohort, or a civic-education title. Every gift maps to a named deliverable.</p>
          <a class="go" href="/get-involved">Donate &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Partner</h3>
          <p>Schools, NGOs, county and national agencies, and governance-sector organisations.</p>
          <a class="go" href="/get-involved">Start a conversation &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Volunteer</h3>
          <p>Mentors, counsellors, civic and AI educators, illustrators, and storytellers.</p>
          <a class="go" href="/get-involved">Give your skills &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · OUR STORY CLOSE -->
  <section class="close" id="story">
    <div class="container close-grid">
      <div class="reveal">
        <span class="kicker">Our story</span>
        <h2>It begins with the book.</h2>
        <p>Virtue Literacy Africa grew out of Virtue Books and its 2024 title <em>Place Called Kibera</em>. Publishing is still the thread that runs through everything we do.</p>
        <div class="actions">
          <a href="/about" class="btn btn-accent">Our full story</a>
          <a href="https://virtuebooks.co.ke" target="_blank" rel="noopener" class="btn">About Virtue Books</a>
        </div>
      </div>
      <figure class="close-fig reveal">
        <Image
          src={childrenHappy}
          alt="Children learning together"
          width={900}
          format="webp"
          quality={72}
        />
      </figure>
    </div>
  </section>

</BaseLayout>
