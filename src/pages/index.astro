---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import childReading from '../assets/child-reading-book.jpg';
import kiberaAerial from '../assets/kibera-aerial.jpg';
import books from '../assets/books.jpg';
import mobileLibrary from '../assets/mobile-library.jpg';
import civicEducation from '../assets/civic-education.jpg';
import fellowship from '../assets/fellowship.jpg';
import kenyanTeacher from '../assets/kenyan-teacher.jpg';
import childrenHappy from '../assets/children-happy.jpg';
---

<BaseLayout
  title="Virtue Literacy Africa: Reading is the first right"
  description="Virtue Literacy Africa empowers children in Africa's informal settlements — mobile libraries, books, civic education, and AI fellowships on the ground, and rigorous research at the policy table."
  currentPage="/"
>

  <!-- 1 · HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker">Virtue Literacy Africa &middot; Nairobi</span>
        <h1>Empowering children in Africa's informal <span class="ac">settlements.</span></h1>
        <div class="lower">
          <div class="hero-lede">
            <p>Across Africa, millions of children are growing up in communities where the distance between their potential and their opportunity is vast &mdash; not because they lack talent, ambition, or drive, but because the structures, resources, and platforms that could unlock that potential have not yet reached them.</p>
            <p>Virtue Literacy Africa exists to close that distance &mdash; on the ground, in the community, and at the level of the ideas and policies that shape the future.</p>
          </div>
          <div class="actions">
            <a href="/get-involved" class="btn btn-accent">Partner with us</a>
            <a href="/programmes" class="btn">Explore programmes</a>
          </div>
        </div>
      </div>
      <figure class="hero-fig">
        <Image
          src={childReading}
          alt="A child reading a book"
          width={900}
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>A reader in Nairobi</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2 · DOCUMENTARY PHOTO -->
  <figure class="testimony">
    <Image
      src={kiberaAerial}
      alt="Kibera settlement, Nairobi"
      width={1600}
      format="webp"
      quality={72}
    />
    <figcaption>Kibera, Nairobi. Phase 1 begins in the settlements where we first documented life on the ground.</figcaption>
  </figure>

  <!-- 3 · BACKGROUND -->
  <section class="background-section">
    <div class="container">
      <div class="reveal">
        <span class="kicker">Background &amp; Inspiration</span>
        <h2>Born from what we witnessed.</h2>
        <p>Virtue Literacy Africa was not founded on an idea. It was founded on evidence &mdash; on the lived realities of communities we entered, listened to, and documented, and on the conviction that bearing witness was not enough.</p>
        <p>When we worked in Kibera, one of Africa's most densely populated informal settlements, we encountered something that stopped us: a generation of children of extraordinary potential growing up without books, without libraries, without the civic knowledge that would help them understand their world and their place in it &mdash; and without the platforms that would allow their voices, their stories, and their achievements to be seen and celebrated.</p>
        <p>What we found in Kibera was not unique to Kibera. It is a pattern that repeats across Kenya and across the continent. And it demanded more than documentation. It demanded a response.</p>

        <div class="callout">
          <span class="callout-label">Where it began</span>
          <h3>A Place Called Kibera</h3>
          <p>Our documentation work produced <em>A Place Called Kibera</em> &mdash; a landmark publication that gave voice to a community too often spoken about rather than spoken with. More than a book, it produced a mandate: that books, knowledge, and civic empowerment are not luxuries for children in informal settlements. They are necessities.</p>
        </div>

        <p style="margin-top:1rem"><a href="/about" class="btn" style="margin-top:0.5rem">Our full story &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- 4 · FIVE PILLARS OVERVIEW -->
  <section class="index" id="programmes">
    <div class="container">
      <div class="top reveal">
        <h2>Six pillars, one ecosystem.</h2>
        <p>Our response operates at two levels and across six interconnected pillars &mdash; from books and mobile libraries on the ground to rigorous research at the policy table.</p>
      </div>
      <div class="pillar-index reveal">
        <article class="pcell feature">
          <div class="ph">
            <Image src={books} alt="Shelves of children's books" width={700} format="webp" quality={72} />
            <span class="pn">01</span>
          </div>
          <div class="pbody">
            <h3>Documentation, Publishing &amp; Inclusive Books</h3>
            <p>Values-based, civic, and accessible titles &mdash; documented and made with local illustrators. The thread that runs through every other pillar.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={mobileLibrary} alt="A child reading an open book" width={700} format="webp" quality={72} />
            <span class="pn">02</span>
          </div>
          <div class="pbody">
            <h3>Mobile Children's Libraries</h3>
            <p>Roving units bringing reading into communities on a reliable, fixed schedule.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={civicEducation} alt="Young people together outdoors" width={700} format="webp" quality={72} />
            <span class="pn">03</span>
          </div>
          <div class="pbody">
            <h3>Reading, Storytelling, Civic Education &amp; Enrichment Events</h3>
            <p>Children read, compete, learn their rights, receive mentorship, and are publicly celebrated.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={fellowship} alt="A child concentrating on a book" width={700} format="webp" quality={72} />
            <span class="pn">04</span>
          </div>
          <div class="pbody">
            <h3>AI Learning Fellowships &amp; Civic Leadership</h3>
            <p>Young people build AI-powered community projects, funded to scale.</p>
          </div>
        </article>
        <article class="pcell">
          <div class="ph">
            <Image src={kenyanTeacher} alt="Children learning together" width={700} format="webp" quality={72} />
            <span class="pn">05</span>
          </div>
          <div class="pbody">
            <h3>Inclusive Development &amp; Mwangaza AI</h3>
            <p>Inclusive books and an offline AI tool for caregivers and teachers in low-connectivity settlements.</p>
          </div>
        </article>
      </div>

      <div class="pillar-bridge reveal">
        <span class="pn">06</span>
        <div class="pb-text">
          <span class="pb-tag">Pillar vi &middot; The policy table</span>
          <h3>African Perspectives on Governance and Development</h3>
          <p>A peer-reviewed, open-access journal publishing rigorous research that informs policy and promotes good governance, development, and social innovation across Africa &mdash; the scholarly voice of Virtue Literacy Africa's work.</p>
        </div>
        <a href="/apgd" class="btn btn-coral">Visit the journal &rarr;</a>
      </div>

      <p style="margin-top:1.5rem"><a href="/programmes" class="btn">See all programmes &rarr;</a></p>
    </div>
  </section>

  <!-- 5 · VISION & MISSION -->
  <section class="vm-section reveal">
    <div class="container">
      <span class="kicker">Our foundation</span>
      <div class="vm-grid">
        <div class="vm-cell">
          <span class="vm-label">Vision</span>
          <h3>An Africa where every child, regardless of where they were born, has access to books, knowledge, and the tools to shape their future.</h3>
        </div>
        <div class="vm-cell">
          <span class="vm-label">Mission</span>
          <p>To document Africa's informal settlement realities and respond with mobile libraries, literacy events, civic education, values-based books, and AI learning fellowships &mdash; nurturing children who are not only literate, but informed, empowered, and ready to lead.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · NUMBERS -->
  <section class="nums">
    <div class="container">
      <span class="kicker">Phase 1 &middot; Year 1 in Nairobi</span>
      <div class="nums-grid">
        <div class="cell"><span class="n">3</span><span class="l">settlements: Kibera, Mathare, Korogocho</span></div>
        <div class="cell"><span class="n">6</span><span class="l">programme pillars, working as one</span></div>
        <div class="cell"><span class="n">2</span><span class="l">mobile library units on the road</span></div>
        <div class="cell"><span class="n">2</span><span class="l">new books published in Year 1</span></div>
      </div>
    </div>
  </section>

  <!-- 7 · ACT -->
  <section class="act" id="act">
    <div class="container">
      <h2>Take part.</h2>
      <div class="act-grid reveal">
        <div class="act-cell">
          <h3>Give</h3>
          <p>Fund a mobile unit, a fellowship cohort, or a civic-education title. Every gift maps to a named deliverable.</p>
          <a class="go" href="/get-involved">Donate &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Partner</h3>
          <p>Schools, NGOs, county and national agencies, and governance-sector organisations.</p>
          <a class="go" href="/get-involved">Start a conversation &rarr;</a>
        </div>
        <div class="act-cell">
          <h3>Volunteer</h3>
          <p>Mentors, counsellors, civic and AI educators, illustrators, and storytellers.</p>
          <a class="go" href="/get-involved">Give your skills &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · OUR STORY CLOSE -->
  <section class="close" id="story">
    <div class="container close-grid">
      <div class="reveal">
        <span class="kicker">Our story</span>
        <h2>It began with what we witnessed.</h2>
        <p>Virtue Literacy Africa was founded on evidence &mdash; on the realities of the communities we documented, and the conviction that bearing witness was not enough. Today our response runs from the child in the settlement to the policy table.</p>
        <div class="actions">
          <a href="/about" class="btn btn-accent">Our full story</a>
          <a href="/apgd" class="btn">Explore the APGD</a>
        </div>
      </div>
      <figure class="close-fig reveal">
        <Image
          src={childrenHappy}
          alt="Children learning together"
          width={900}
          format="webp"
          quality={72}
        />
      </figure>
    </div>
  </section>

</BaseLayout>
