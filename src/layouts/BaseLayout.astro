---
import '../styles/global.css';
import { reader } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  /** Root-relative share image, e.g. "/images/blog/foo.jpg". Falls back to the brand card. */
  shareImage?: string;
  /** "article" for blog posts, so link unfurls label them correctly. */
  shareType?: 'website' | 'article';
}

const {
  title,
  description = 'Virtue Literacy Africa advances literacy for children and youth in pastoralist, refugee, and arid and semi-arid communities across Kenya, Ethiopia, and South Sudan.',
  currentPage = '',
  shareImage = '/og-default.png',
  shareType = 'website',
} = Astro.props;

// Share tags need absolute URLs. Astro.site comes from astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImageUrl = new URL(shareImage, Astro.site).href;

const banner = (await reader.singletons.banner.read())!;
const showBanner = banner.show && Boolean(banner.message?.trim());

const nav = [
  { href: '/about', label: 'Our Story' },
  { href: '/programmes', label: 'Programmes' },
  { href: '/research', label: 'Research' },
  { href: '/get-involved', label: 'Get Involved' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Link previews: WhatsApp, Facebook, LinkedIn, Slack. -->
  <meta property="og:type" content={shareType} />
  <meta property="og:site_name" content="Virtue Literacy Africa" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImageUrl} />
  {shareImage === '/og-default.png' && (
    <>
      {/* Only the brand card has known dimensions; declaring them for an
          arbitrary cover photo would mis-crop the preview. */}
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Virtue Literacy Africa: meeting children where they are." />
    </>
  )}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImageUrl} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&display=swap" rel="stylesheet" />
</head>
<body>

  {currentPage === '/' && showBanner && (
    <aside class="jbanner" id="jbanner" aria-label="Announcement">
      <div class="jbanner-inner">
        {banner.tag && <span class="jbanner-tag">{banner.tag}</span>}
        <p>{banner.message}</p>
        {banner.ctaLabel && banner.ctaHref && (
          <a href={banner.ctaHref} class="jbanner-link">{banner.ctaLabel}</a>
        )}
        <button type="button" class="jbanner-close" id="jbanner-close" aria-label="Dismiss announcement">&times;</button>
      </div>
    </aside>
  )}

  <header class="site-header">
    <nav class="nav" aria-label="Primary">
      <a href="/" class="brand" aria-label="Virtue Literacy Africa home">
        <img class="brand-mark" src="/logo.svg" alt="" width="44" height="40" />
        <span class="brand-text">
          <b>Virtue Literacy Africa</b>
          <small>Kenya &middot; Ethiopia &middot; South Sudan</small>
        </span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-menu" id="nav-menu">
        <div class="nav-links">
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={currentPage === href ? 'page' : undefined}>{label}</a>
          ))}
        </div>
        <a href="/donate" class="donate-block">Donate</a>
        <a href="/donate" class="donate-m">Donate</a>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <img class="footer-mark" src="/logo-inverse.svg" alt="" width="64" height="58" />
          <b>Virtue Literacy Africa</b>
          <p>Advancing literacy for children and youth in pastoralist, refugee, and arid and semi-arid communities across Kenya, Ethiopia, and South Sudan, by combining community-rooted programmes, research and evidence-sharing, and innovation.</p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>
            <li><a href="/about">Our Story</a></li>
            <li><a href="/programmes">Programmes</a></li>
            <li><a href="/research">Research &amp; Findings</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/team">Team</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/gallery">Gallery</a></li>
            <li><a href="/get-involved">Get Involved</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4>Programmes</h4>
          <ul>
            <li><a href="/programmes#literacy">Literacy Programmes</a></li>
            <li><a href="/programmes#mobile-learning">Mobile &amp; Community Learning</a></li>
            <li><a href="/programmes#innovation">Innovation &amp; AI in Education</a></li>
            <li><a href="/programmes#innovation">Mwangaza AI</a></li>
            <li><a href="/programmes#partnerships">Community Partnerships</a></li>
            <li><a href="/programmes#research">Research &amp; Evidence</a></li>
          </ul>
        </div>
        <div class="newsletter">
          <h4>Stay in touch</h4>
          <p>Occasional updates on our work. No spam.</p>
          <form onsubmit="event.preventDefault(); this.reset(); this.querySelector('input').placeholder='Subscribed. Thank you.';">
            <label class="sr-only" for="nl">Email address</label>
            <input id="nl" type="email" required placeholder="you@example.org" />
            <button type="submit">Join</button>
          </form>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Virtue Literacy Africa. All rights reserved. Literacy for children and youth in marginalised and displaced communities.</span>
        <span>Nairobi, Kenya &middot; <a href="mailto:info@virtueliteracyafrica.org" style="color:inherit">info@virtueliteracyafrica.org</a></span>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      "use strict";
      var toggle = document.querySelector(".nav-toggle");
      var menu = document.getElementById("nav-menu");
      if (toggle && menu) {
        toggle.addEventListener("click", function () {
          var open = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!open));
          menu.classList.toggle("open", !open);
        });
        menu.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () {
            toggle.setAttribute("aria-expanded", "false");
            menu.classList.remove("open");
          });
        });
      }
      var jb = document.getElementById("jbanner");
      var jbc = document.getElementById("jbanner-close");
      if (jb && jbc) {
        try { if (localStorage.getItem("vla-banner-dismissed") === "1") jb.hidden = true; } catch (e) {}
        jbc.addEventListener("click", function () {
          jb.hidden = true;
          try { localStorage.setItem("vla-banner-dismissed", "1"); } catch (e) {}
        });
      }
      var reveals = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && reveals.length) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: "0px 0px -40px 0px" });
        reveals.forEach(function (el) { io.observe(el); });
      } else {
        reveals.forEach(function (el) { el.classList.add("in"); });
      }
    })();
  </script>

</body>
</html>
